rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One progress document per learner per course: users/{uid}/progress/{courseId}.
    // A learner can read and write only their own; nobody can list other users.
    match /users/{uid}/progress/{courseId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProgress(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Shape check, so a client cannot park arbitrary or oversized data in the account.
    // Fields are read with get(): a first write may carry only the fields it touched.
    function isValidProgress(d) {
      return d.keys().hasOnly([
          'version', 'learned', 'bookmarks', 'lastOpened', 'questions',
          'sessions', 'legacyImported', 'updatedAt'
        ])
        && d.get('version', 2) == 2
        && d.get('learned', {}) is map && d.get('learned', {}).size() <= 2000
        && d.get('bookmarks', []) is list && d.get('bookmarks', []).size() <= 2000
        && d.get('questions', {}) is map && d.get('questions', {}).size() <= 5000
        && d.get('sessions', []) is list && d.get('sessions', []).size() <= 50
        && d.get('legacyImported', []) is list && d.get('legacyImported', []).size() <= 500
        && d.get('lastOpened', '') is string && d.get('lastOpened', '').size() <= 200
        && d.get('updatedAt', request.time) is timestamp;
    }
  }
}
